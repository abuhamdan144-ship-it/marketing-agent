rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthorized(userId) {
      return (request.auth != null && request.auth.uid == userId) || 
             (request.auth == null && userId != null && userId != "");
    }

    match /companies/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /camps/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /customers/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /visits/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /feedback/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /complaints/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /competitors/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /social/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /plans/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /attendance/{id} {
      allow read: if isAuthorized(resource.data.userId);
      allow create: if isAuthorized(request.resource.data.userId);
      allow update: if isAuthorized(resource.data.userId) && isAuthorized(request.resource.data.userId);
      allow delete: if isAuthorized(resource.data.userId);
    }

    match /settings/{userId} {
      allow read: if isAuthorized(userId);
      allow create, update: if isAuthorized(userId);
      allow delete: if isAuthorized(userId);
    }
  }
}
